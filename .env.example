# Copy this file to .env and fill in your actual values

# Chromatic project token (get from https://chromatic.com)
CHROMATIC_PROJECT_TOKEN=your_chromatic_token_here

# Site URL for social media meta tags (automatically set in GitHub Actions)
# For local development, you can use:
# - http://localhost:5173/ (for local testing, but social media previews won't work)
# - https://yourusername.github.io/your-repo-name/ (recommended - points to production)
VITE_SITE_URL=http://localhost:5173/